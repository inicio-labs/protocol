use miden::core::math::u64
use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::asset
use miden::protocol::note
use miden::protocol::output_note
use miden::standards::notes::p2id
use miden::standards::wallets::basic->wallet

# CONSTANTS
# =================================================================================================

const NOTE_TYPE_MASK = 0x03
const FACTOR = 100000
const MAX_U32 = 0x0000000100000000

const PSWAP_NUM_STORAGE_ITEMS = 18

# Note storage layout (18 felts, loaded at STORAGE_PTR by get_storage):
# - REQUESTED_ASSET_KEY   [0..3]   : 4 felts
# - REQUESTED_ASSET_VALUE [4..7]   : 4 felts
# - pswap_tag             [8]      : 1 felt
# - p2id_tag              [9]      : 1 felt
# - padding               [10..11] : 2 felts
# - swap_count            [12..15] : 4 felts
# - creator_id_prefix     [16]     : 1 felt
# - creator_id_suffix     [17]     : 1 felt
#
# Where:
# - REQUESTED_ASSET_KEY: The asset key word of the requested fungible asset (asset.to_key_word())
# - REQUESTED_ASSET_VALUE: The asset value word of the requested fungible asset
#   (asset.to_value_word()); the token amount is stored at index 4
# - pswap_tag: The NoteTag for remainder PSWAP notes, derived from the offered/requested asset pair
# - p2id_tag: The NoteTag for P2ID payback notes, derived from the creator's account ID
# - swap_count: Number of times this note has been partially filled and re-created
#   (index 12; indices 13-15 are zero)
# - creator_id_prefix: The prefix of the creator's AccountId (AccountIdPrefix as Felt)
# - creator_id_suffix: The suffix of the creator's AccountId (Felt)

const STORAGE_PTR = 0
const REQUESTED_ASSET_KEY_ITEM = STORAGE_PTR
const REQUESTED_ASSET_VALUE_ITEM = STORAGE_PTR + 4
const PSWAP_TAG_ITEM = STORAGE_PTR + 8
const P2ID_TAG_ITEM = STORAGE_PTR + 9
const SWAP_COUNT_ITEM = STORAGE_PTR + 12
const CREATOR_PREFIX_ITEM = STORAGE_PTR + 16
const CREATOR_SUFFIX_ITEM = STORAGE_PTR + 17

# Working memory (starts after note storage)
const OFFERED_ASSET_PTR = 20
const OFFERED_ASSET_KEY_PTR = 28
const REQUESTED_ASSET_KEY_PTR = 32

# Scalar working variables
const AMT_OFFERED = 36
const AMT_REQUESTED = 37
const AMT_REQUESTED_IN = 38
const AMT_REQUESTED_INFLIGHT = 39
const AMT_OFFERED_OUT = 40
const AMT_OFFERED_OUT_INPUT = 41
const AMT_OFFERED_OUT_INFLIGHT = 42
const CALC_AMT_IN = 43

# Output note state
const NOTE_TYPE_PTR = 44
const P2ID_NOTE_IDX = 45
const PSWAP_NOTE_IDX = 46

# P2ID recipient storage (creator account ID written here for build_recipient)
const P2ID_RECIPIENT_SUFFIX = 48
const P2ID_RECIPIENT_PREFIX = 49

# ERRORS
# =================================================================================================

const ERR_PSWAP_WRONG_NUMBER_OF_INPUTS = "PSWAP script expects exactly 18 note storage items"
const ERR_PSWAP_WRONG_NUMBER_OF_ASSETS = "PSWAP script requires exactly one note asset"
const ERR_PSWAP_FILL_EXCEEDS_REQUESTED = "PSWAP fill amount exceeds requested amount"

# HELPER PROCEDURES
# =================================================================================================

#! Extracts the note_type from the active note's metadata and stores it at NOTE_TYPE_PTR.
#!
#! METADATA_HEADER word layout (see NoteMetadataHeader):
#!   word[0] = sender_suffix_and_note_type (note_type in bits 0-1)
#!   word[1] = sender_id_prefix
#!   word[2] = tag
#!   word[3] = attachment_kind_scheme
#!
#! Inputs:  []
#! Outputs: []
#!
#! Invocation: exec
proc extract_note_type
    exec.active_note::get_metadata
    # => [NOTE_ATTACHMENT, METADATA_HEADER]

    dropw
    # => [sender_suffix_and_note_type, prefix, tag, attachment]

    movdn.3 drop drop drop
    # => [sender_suffix_and_note_type]

    u32split push.NOTE_TYPE_MASK u32and
    # => [note_type, hi32]

    mem_store.NOTE_TYPE_PTR drop
    # => []
end

#! Checks if the consuming account is the creator of the note.
#!
#! Compares the active account's ID against the creator ID stored in note storage.
#!
#! Inputs:  []
#! Outputs: [is_creator]
#!
#! Invocation: exec
proc is_consumer_creator
    exec.active_account::get_id
    # => [acct_id_suffix, acct_id_prefix]

    mem_load.CREATOR_PREFIX_ITEM mem_load.CREATOR_SUFFIX_ITEM
    # => [creator_suffix, creator_prefix, acct_id_suffix, acct_id_prefix]

    movup.3 movup.3
    # => [acct_id_suffix, acct_id_prefix, creator_suffix, creator_prefix]

    exec.account_id::is_equal
    # => [is_creator]
end

#! Reclaims all assets from the note back to the creator's vault.
#!
#! Called when the consumer IS the creator (cancel/reclaim path).
#!
#! Inputs:  []
#! Outputs: []
#!
#! Invocation: exec
proc handle_reclaim
    push.OFFERED_ASSET_PTR exec.active_note::get_assets
    # => [num_assets, dest_ptr]

    drop drop
    # => []

    push.OFFERED_ASSET_PTR exec.asset::load
    # => [ASSET_KEY, ASSET_VALUE]

    padw padw swapdw
    # => [ASSET_KEY, ASSET_VALUE, pad(8)]

    call.wallet::receive_asset
    # => [pad(16)]

    dropw dropw dropw dropw
    # => []
end

#! Computes the proportional amount of offered tokens for a given requested input.
#!
#! Uses u64 integer arithmetic with a precision factor of 1e5 to handle
#! non-integer ratios without floating point.
#!
#! Formula:
#!   if input == requested:   result = offered  (exact, avoids precision loss)
#!   if offered >= requested: result = (offered * FACTOR / requested) * input / FACTOR
#!   if requested > offered:  result = (input * FACTOR) / (requested * FACTOR / offered)
#!
#! u64 conventions used in this procedure:
#!   After u32split: [lo, hi] with lo on top
#!   u64::wrapping_mul: [b_lo, b_hi, a_lo, a_hi] => [c_lo, c_hi]
#!   u64::div:          [b_lo, b_hi, a_lo, a_hi] => [q_lo, q_hi]
#!   Combine to felt:   swap push.MAX_U32 mul add
#!
#! Inputs:  [offered, requested, input]
#! Outputs: [offered_out]
#!
#! Invocation: exec
proc calculate_tokens_offered_for_requested
    movup.2 mem_store.CALC_AMT_IN
    # => [offered, requested]

    # Full fill shortcut: if input == requested, return offered directly
    dup.1 mem_load.CALC_AMT_IN eq
    # => [is_full_fill, offered, requested]

    if.true
        swap drop
        # => [offered]
    else
        dup.1 dup.1 gt
        # => [requested > offered, offered, requested]

        if.true
            # Case: requested > offered
            # ratio  = (requested * FACTOR) / offered
            # result = (input * FACTOR) / ratio
            swap u32split push.FACTOR u32split
            # => [F_lo, F_hi, req_lo, req_hi, offered]

            exec.u64::wrapping_mul
            # => [(req*F)_lo, (req*F)_hi, offered]

            movup.2 u32split
            # => [off_lo, off_hi, (req*F)_lo, (req*F)_hi]

            exec.u64::div
            # => [ratio_lo, ratio_hi]

            mem_load.CALC_AMT_IN u32split push.FACTOR u32split
            # => [F_lo, F_hi, in_lo, in_hi, ratio_lo, ratio_hi]

            exec.u64::wrapping_mul
            # => [(in*F)_lo, (in*F)_hi, ratio_lo, ratio_hi]

            movup.3 movup.3
            # => [ratio_lo, ratio_hi, (in*F)_lo, (in*F)_hi]

            exec.u64::div
            # => [result_lo, result_hi]

            swap push.MAX_U32 mul add
            # => [result]
        else
            # Case: offered >= requested
            # result = ((offered * FACTOR) / requested) * input / FACTOR
            u32split push.FACTOR u32split
            # => [F_lo, F_hi, off_lo, off_hi, requested]

            exec.u64::wrapping_mul
            # => [(off*F)_lo, (off*F)_hi, requested]

            movup.2 u32split
            # => [req_lo, req_hi, (off*F)_lo, (off*F)_hi]

            exec.u64::div
            # => [ratio_lo, ratio_hi]

            mem_load.CALC_AMT_IN u32split
            # => [in_lo, in_hi, ratio_lo, ratio_hi]

            exec.u64::wrapping_mul
            # => [(ratio*in)_lo, (ratio*in)_hi]

            push.FACTOR u32split
            # => [F_lo, F_hi, (ratio*in)_lo, (ratio*in)_hi]

            exec.u64::div
            # => [result_lo, result_hi]

            swap push.MAX_U32 mul add
            # => [result]
        end
    end
end

#! Builds the P2ID recipient hash for the swap creator.
#!
#! Copies the creator's account ID from note storage into a temporary P2ID storage
#! layout [suffix, prefix] and calls note::build_recipient.
#!
#! Inputs:  [SERIAL_NUM, SCRIPT_ROOT]
#! Outputs: [P2ID_RECIPIENT]
#!
#! Invocation: exec
proc build_p2id_recipient_hash
    mem_load.CREATOR_SUFFIX_ITEM mem_store.P2ID_RECIPIENT_SUFFIX
    mem_load.CREATOR_PREFIX_ITEM mem_store.P2ID_RECIPIENT_PREFIX
    # => [SERIAL_NUM, SCRIPT_ROOT]

    push.2.P2ID_RECIPIENT_SUFFIX
    # => [storage_ptr, num_storage_items, SERIAL_NUM, SCRIPT_ROOT]

    exec.note::build_recipient
    # => [P2ID_RECIPIENT]
end

# NOTE CREATION PROCEDURES
# =================================================================================================

#! Creates a P2ID output note to send the requested asset back to the swap creator.
#!
#! Derives a unique serial number from the swap count and the active note's serial,
#! computes the P2ID recipient, creates the output note, sets the attachment,
#! and adds the requested assets (from vault and/or inflight).
#!
#! Inputs:  []
#! Outputs: []
#!
#! Invocation: exec
proc create_p2id_note
    # --- derive P2ID serial number ---

    procref.p2id::main
    # => [P2ID_SCRIPT_ROOT]

    # Increment swap count for unique serial per P2ID note in chained fills
    mem_load.SWAP_COUNT_ITEM add.1 mem_store.SWAP_COUNT_ITEM
    # => [P2ID_SCRIPT_ROOT]

    padw mem_loadw_le.SWAP_COUNT_ITEM
    # => [SWAP_COUNT_WORD, P2ID_SCRIPT_ROOT]

    exec.active_note::get_serial_number
    # => [SERIAL_NUM, SWAP_COUNT_WORD, P2ID_SCRIPT_ROOT]

    swapw hmerge
    # => [P2ID_SERIAL_NUM, P2ID_SCRIPT_ROOT]

    # --- build recipient and create note ---

    exec.build_p2id_recipient_hash
    # => [P2ID_RECIPIENT]

    mem_load.NOTE_TYPE_PTR mem_load.P2ID_TAG_ITEM
    # => [tag, note_type, P2ID_RECIPIENT]

    exec.output_note::create
    # => [note_idx]

    mem_store.P2ID_NOTE_IDX
    # => []

    # --- set attachment (aux = total fill amount) ---

    mem_load.AMT_REQUESTED_IN mem_load.AMT_REQUESTED_INFLIGHT add
    push.0.0.0
    # => [0, 0, 0, aux]

    push.0 mem_load.P2ID_NOTE_IDX
    # => [note_idx, attachment_scheme, ATTACHMENT]

    exec.output_note::set_word_attachment
    # => []

    # --- add input_amount from consumer's vault to P2ID note ---

    mem_load.AMT_REQUESTED_IN dup push.0 neq
    # => [has_input, amt]

    if.true
        drop

        padw push.0.0.0 mem_load.P2ID_NOTE_IDX
        # => [note_idx, pad(7)]

        push.0.0.0 mem_load.AMT_REQUESTED_IN
        # => [amount, 0, 0, 0, note_idx, pad(7)]

        padw mem_loadw_le.REQUESTED_ASSET_KEY_PTR
        # => [ASSET_KEY, ASSET_VALUE, note_idx, pad(7)]

        call.wallet::move_asset_to_note
        # => [pad(16)]

        dropw dropw dropw dropw
        # => []
    else
        drop
    end

    # --- add inflight_amount directly to P2ID note (no vault debit) ---

    mem_load.AMT_REQUESTED_INFLIGHT dup push.0 neq
    # => [has_inflight, amt]

    if.true
        drop

        mem_load.P2ID_NOTE_IDX
        # => [note_idx]

        push.0.0.0 mem_load.AMT_REQUESTED_INFLIGHT
        # => [amount, 0, 0, 0, note_idx]

        padw mem_loadw_le.REQUESTED_ASSET_KEY_PTR
        # => [ASSET_KEY, ASSET_VALUE, note_idx]

        exec.output_note::add_asset
        # => []
    else
        drop
    end
end

#! Creates a PSWAP remainder output note for partial fills.
#!
#! Updates the requested amount in note storage, builds a new remainder recipient
#! (using the active note's script root and a serial derived by incrementing the
#! top element of the active note's serial number), creates the output note,
#! sets the attachment, and adds the remaining offered asset.
#!
#! Inputs:  [remaining_requested]
#! Outputs: []
#!
#! Invocation: exec
proc create_remainder_note
    mem_store.REQUESTED_ASSET_VALUE_ITEM
    # => []

    # --- build remainder recipient ---

    exec.active_note::get_script_root
    # => [SCRIPT_ROOT]

    # Derive serial: increment top element of active note's serial
    exec.active_note::get_serial_number add.1
    # => [SERIAL_NUM', SCRIPT_ROOT]

    push.PSWAP_NUM_STORAGE_ITEMS.STORAGE_PTR
    # => [storage_ptr, num_storage_items, SERIAL_NUM', SCRIPT_ROOT]

    exec.note::build_recipient
    # => [RECIPIENT]

    # --- create output note ---

    mem_load.NOTE_TYPE_PTR mem_load.PSWAP_TAG_ITEM
    # => [tag, note_type, RECIPIENT]

    exec.output_note::create
    # => [note_idx]

    mem_store.PSWAP_NOTE_IDX
    # => []

    # --- set attachment (aux = total offered_out) ---

    mem_load.AMT_OFFERED_OUT push.0.0.0
    # => [0, 0, 0, aux]

    push.0 mem_load.PSWAP_NOTE_IDX
    # => [note_idx, attachment_scheme, ATTACHMENT]

    exec.output_note::set_word_attachment
    # => []

    # --- add remaining offered asset ---

    mem_load.PSWAP_NOTE_IDX
    # => [note_idx]

    push.0.0.0
    mem_load.AMT_OFFERED mem_load.AMT_OFFERED_OUT sub
    # => [remainder_amount, 0, 0, 0, note_idx]

    padw mem_loadw_le.OFFERED_ASSET_KEY_PTR
    # => [ASSET_KEY, ASSET_VALUE, note_idx]

    exec.output_note::add_asset
    # => []
end

#! Executes the partially-fillable swap.
#!
#! Sends offered tokens to the consumer, requested tokens to the creator via a P2ID note,
#! and creates a remainder PSWAP note if partially filled.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Invocation: exec
proc execute_pswap
    # --- load and store offered asset ---

    push.OFFERED_ASSET_PTR exec.active_note::get_assets
    # => [num_assets, asset_ptr]

    push.1 eq assert.err=ERR_PSWAP_WRONG_NUMBER_OF_ASSETS drop
    # => []

    push.OFFERED_ASSET_PTR exec.asset::load
    # => [ASSET_KEY, ASSET_VALUE]

    exec.asset::fungible_to_amount mem_store.AMT_OFFERED
    # => [ASSET_KEY, ASSET_VALUE]

    mem_storew_le.OFFERED_ASSET_KEY_PTR dropw dropw
    # => []

    # --- load and store requested asset from note storage ---

    push.REQUESTED_ASSET_KEY_ITEM exec.asset::load
    # => [ASSET_KEY, ASSET_VALUE]

    exec.asset::fungible_to_amount mem_store.AMT_REQUESTED
    # => [ASSET_KEY, ASSET_VALUE]

    mem_storew_le.REQUESTED_ASSET_KEY_PTR dropw dropw
    # => []

    # --- default to full fill when note_args are zero (network account path) ---

    mem_load.AMT_REQUESTED_IN mem_load.AMT_REQUESTED_INFLIGHT add push.0 eq
    if.true
        mem_load.AMT_REQUESTED mem_store.AMT_REQUESTED_IN
    end

    # --- validate fill amount ---

    mem_load.AMT_REQUESTED_IN mem_load.AMT_REQUESTED_INFLIGHT add
    mem_load.AMT_REQUESTED
    # => [requested, fill_amount]

    lte assert.err=ERR_PSWAP_FILL_EXCEEDS_REQUESTED
    # => []

    # --- calculate offered_out for input and inflight separately ---
    # Input portion goes to consumer's vault; total determines remainder.

    mem_load.AMT_REQUESTED_IN mem_load.AMT_REQUESTED mem_load.AMT_OFFERED
    # => [offered, requested, input_amount]

    exec.calculate_tokens_offered_for_requested mem_store.AMT_OFFERED_OUT_INPUT
    # => []

    mem_load.AMT_REQUESTED_INFLIGHT mem_load.AMT_REQUESTED mem_load.AMT_OFFERED
    # => [offered, requested, inflight_amount]

    exec.calculate_tokens_offered_for_requested mem_store.AMT_OFFERED_OUT_INFLIGHT
    # => []

    mem_load.AMT_OFFERED_OUT_INPUT mem_load.AMT_OFFERED_OUT_INFLIGHT add
    mem_store.AMT_OFFERED_OUT
    # => []

    # --- create P2ID note for creator ---

    exec.create_p2id_note
    # => []

    # --- send offered tokens to consumer's vault ---

    padw padw
    push.OFFERED_ASSET_PTR exec.asset::load
    # => [ASSET_KEY, ASSET_VALUE, pad(8)]

    # Replace amount with input_offered_out
    movup.4 drop mem_load.AMT_OFFERED_OUT_INPUT movdn.4
    # => [ASSET_KEY, ASSET_VALUE', pad(8)]

    call.wallet::receive_asset
    dropw dropw dropw dropw
    # => []

    # --- create remainder note if partial fill ---

    mem_load.AMT_REQUESTED_IN mem_load.AMT_REQUESTED_INFLIGHT add
    mem_load.AMT_REQUESTED
    dup.1 dup.1 lt
    # => [is_partial, requested, fill_amount]

    if.true
        swap sub
        # => [remaining_requested]

        exec.create_remainder_note
    else
        drop drop
    end
end

# NOTE SCRIPT
# =================================================================================================

#! Partially-fillable swap (PSWAP) note script: exchanges offered tokens for requested tokens
#! with support for partial fills.
#!
#! This note can be consumed in two ways:
#! - If the consuming account is the creator (reclaim case): the note's assets are added back to
#!   the consuming account.
#! - Otherwise (swap case): the consumer provides some or all of the requested tokens and receives
#!   a proportional amount of the offered tokens. A P2ID note is created to send the requested
#!   tokens to the creator. If the fill is partial, a remainder PSWAP note is created with the
#!   unfilled portion.
#!
#! Requires that the account exposes:
#! - miden::standards::wallets::basic::receive_asset procedure.
#! - miden::standards::wallets::basic::move_asset_to_note procedure.
#! - miden::standards::wallets::basic::add_assets_to_account procedure (reclaim path).
#!
#! Inputs:  [NOTE_ARGS]
#! Outputs: []
#!
#! Note args layout (top to bottom):
#! - input_amount:    amount debited from consumer's vault
#! - inflight_amount: amount added directly to P2ID note (no vault debit)
#! - (unused):        0
#! - (unused):        0
#!
#! When both input_amount and inflight_amount are 0 (e.g., network transactions where note_args
#! default to [0, 0, 0, 0]), the script defaults to a full fill (input_amount = requested).
#!
#! NoteStorage layout (18 felts total):
#! - REQUESTED_ASSET_KEY   [0..3]   : 4 felts
#! - REQUESTED_ASSET_VALUE [4..7]   : 4 felts
#! - pswap_tag             [8]      : 1 felt
#! - p2id_tag              [9]      : 1 felt
#! - padding               [10..11] : 2 felts
#! - swap_count            [12..15] : 4 felts
#! - creator_id_prefix     [16]     : 1 felt
#! - creator_id_suffix     [17]     : 1 felt
#!
#! Where:
#! - REQUESTED_ASSET_KEY: The asset key word of the requested fungible asset (asset.to_key_word())
#! - REQUESTED_ASSET_VALUE: The asset value word of the requested fungible asset
#!   (asset.to_value_word()); the token amount is stored at index 4
#! - pswap_tag: The NoteTag for remainder PSWAP notes, derived from the offered/requested asset pair
#! - p2id_tag: The NoteTag for P2ID payback notes, derived from the creator's account ID
#! - swap_count: Number of times this note has been partially filled and re-created
#!   (index 12; indices 13-15 are zero)
#! - creator_id_prefix: The prefix of the creator's AccountId (AccountIdPrefix as Felt)
#! - creator_id_suffix: The suffix of the creator's AccountId (Felt)
#!
#! Panics if:
#! - The note does not contain exactly 18 storage items.
#! - The note does not contain exactly 1 asset.
#! - The fill amount (input + inflight) exceeds the total requested amount.
@note_script
pub proc main
    # => [input_amount, inflight_amount, 0, 0]

    mem_store.AMT_REQUESTED_IN mem_store.AMT_REQUESTED_INFLIGHT drop drop
    # => []

    # Load note storage to memory
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_storage_items, storage_ptr]

    eq.PSWAP_NUM_STORAGE_ITEMS assert.err=ERR_PSWAP_WRONG_NUMBER_OF_INPUTS drop
    # => []

    exec.extract_note_type
    # => []

    exec.is_consumer_creator
    # => [is_creator]

    if.true
        exec.handle_reclaim
    else
        exec.execute_pswap
    end
end
